[global]
    width = 300
    height = 100
    offset = 10x50
    origin = top-right
    transparency = 10
    corner_radius = 10
    frame_width = 2
    gap_size = 5
    font = JetBrains Mono Nerd Font 10
    icon_theme = Papirus
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    frame_color = "#E1777D"
    separator_color = "#979367"
    background = "#2D1F2D"
    foreground = "#E8D5AB"
[urgency_low]
    frame_color = "#979367"
    timeout = 5
[urgency_normal]
    frame_color = "#E1777D"
    timeout = 10
[urgency_critical]
    foreground = "#E1777D"
    frame_color = "#BD6161"
    timeout = 0

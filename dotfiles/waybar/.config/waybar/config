{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": ["hyprland/workspaces", "hyprland/window", "custom/updates"],
  "modules-center": ["clock"],
  "modules-right": ["network", "bluetooth", "cpu", "memory", "disk", "custom/gpu", "pulseaudio", "custom/power"],
  "hyprland/workspaces": {"format": "{icon}", "format-icons": {"active": "", "default": "", "urgent": ""}, "persistent-workspaces": {"*": 5}},
  "clock": {"format": "󰥔 {:%H:%M}", "format-alt": "{:%A, %d %B %Y}", "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"},
  "cpu": {"format": "󰻠 {usage}%", "interval": 2},
  "memory": {"format": "󰍛 {percentage}%", "interval": 5},
  "disk": {"format": "󰋊 {percentage_used}%", "path": "/", "interval": 30},
  "network": {"format-wifi": " {signalStrength}%", "format-ethernet": "󰈀 wired", "format-disconnected": "󰖪 offline", "tooltip-format": "{ifname}"},
  "bluetooth": {"format": "󰂯", "format-disabled": "󰂲", "format-connected": "󰂱 {num_connections}", "on-click": "blueman-manager"},
  "pulseaudio": {"format": "{icon} {volume}%", "format-muted": "󰝟", "format-icons": {"default": ["", "", ""]}, "on-click": "pavucontrol"},
  "custom/gpu": {"exec-if": "command -v nvidia-smi", "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader", "format": "󰢮 {}°C", "interval": 5},
  "custom/updates": {"exec": "checkupdates | wc -l", "format": "󰏔 {}", "interval": 3600, "on-click": "kitty -e sudo pacman -Syu"},
  "custom/power": {"format": "⏻", "on-click": "$HOME/.config/rofi/power/powermenu.sh", "tooltip": false}
}
